#!/bin/bash
# antler [--depth N] [--hide-clean] [FOLDER]: opens FOLDER (default: the current one) in a window of Antler.app, like `code .`.
# Installed in ~/.local/bin by `scripts/bundle.sh --install`.
set -euo pipefail

app=/Applications/Antler.app
if [[ ! -d $app ]]; then
    echo "antler: $app is not installed; install it with: brew install --cask gianmadd/tap/antler" >&2
    exit 1
fi

flags=()
folder=$PWD
while (($#)); do
    case $1 in
        --depth)
            flags+=("$1")
            shift
            if (($#)); then flags+=("$1"); shift; fi # a missing or wrong number is reported by the app
            ;;
        -*) flags+=("$1"); shift ;;
        *) folder=$1; shift ;;
    esac
done
if [[ ! -d $folder ]]; then
    echo "antler: $folder is not a folder" >&2
    exit 1
fi
folder=$(cd "$folder" && pwd)

# One app, many windows: with the app running, `open -a` hands the folder to it (a new window, or the one that has it)
# and the flags cannot reach it; otherwise it starts with the flags and the folder as arguments.
if pgrep -qf "$app/Contents/MacOS/antler"; then
    ((${#flags[@]})) && echo "antler: Antler is already running, ${flags[*]} ignored (the flags apply when the app starts)" >&2
    exec open -a "$app" "$folder"
fi
exec open -a "$app" --args ${flags[@]+"${flags[@]}"} "$folder"
